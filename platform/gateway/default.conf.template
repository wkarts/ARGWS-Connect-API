map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream connect_engine { server connect-engine:8080; keepalive 64; }
upstream connect_platform_api { server connect-platform-api:8000; keepalive 64; }
upstream connect_platform_web { server connect-platform-web:80; keepalive 32; }
upstream connect_docs { server connect-docs:8080; keepalive 16; }

# Public REST endpoint — canonical Connect|API Engine.
server {
    listen 80;
    server_name ${API_HOST};
    client_max_body_size 100m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    location / { proxy_read_timeout 180s; proxy_send_timeout 180s; proxy_pass http://connect_engine; }
}

# Official documentation.
server {
    listen 80;
    server_name ${DOCS_HOST};
    client_max_body_size 50m;
    location / { proxy_pass http://connect_docs; }
}

# Platform, Control Plane, Partner Plane and tenant hosts.
server {
    listen 80 default_server;
    server_name ${PLATFORM_DOMAIN} ${CONTROL_PLANE_HOST} ${ADMIN_HOST} ${PARTNER_PLANE_HOST} ${DEMO_HOST} .${TENANT_DOMAIN_ROOT} _;
    client_max_body_size 100m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    location = /health/live { proxy_pass http://connect_platform_api; }
    location = /health/ready { proxy_pass http://connect_platform_api; }
    location /api/ { proxy_read_timeout 180s; proxy_send_timeout 180s; proxy_pass http://connect_platform_api; }
    location / { proxy_pass http://connect_platform_web; }
}
