map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream financial_api {
    server connect-api:8000;
    keepalive 64;
}

upstream financial_web {
    server connect-web:80;
    keepalive 32;
}

server {
    listen 80;
    server_name ${PLATFORM_DOMAIN};
    client_max_body_size 100m;
    root /usr/share/nginx/landing;
    index index.html;

    location = /health/live { proxy_pass http://financial_api; }
    location = /health/ready { proxy_pass http://financial_api; }
    location = /metrics { return 404; }
    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass http://financial_api;
    }
    location / { try_files $uri $uri/ /index.html; }
}

server {
    listen 80;
    server_name ${API_HOST};
    client_max_body_size 100m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    location = /metrics { return 404; }
    location / { proxy_read_timeout 120s; proxy_send_timeout 120s; proxy_pass http://financial_api; }
}

server {
    listen 80 default_server;
    server_name ${CONTROL_PLANE_HOST} ${ADMIN_HOST} ${DEMO_HOST} .${TENANT_DOMAIN_ROOT} _;
    client_max_body_size 100m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    location = /health/live { proxy_pass http://financial_api; }
    location = /health/ready { proxy_pass http://financial_api; }
    location = /metrics { return 404; }
    location /api/ { proxy_read_timeout 120s; proxy_send_timeout 120s; proxy_pass http://financial_api; }
    location / { proxy_pass http://financial_web; }
}
