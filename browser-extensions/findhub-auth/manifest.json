{
  "manifest_version": 3,
  "name": "Connect|API — Find Hub Auth",
  "version": "0.1.4",
  "minimum_chrome_version": "120",
  "description": "Vinculação consentida de uma conta Google Find Hub à sua instalação Connect|API. Sem telemetria.",
  "key": "",
  "permissions": [
    "scripting"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "<all_urls>"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Connect|API — Find Hub Auth",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
