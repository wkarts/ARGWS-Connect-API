{
  "manifest_version": 3,
  "name": "Connect|API \u2014 Find Hub Auth",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Vincula\u00e7\u00e3o consentida de uma conta Google Find Hub \u00e0 sua instala\u00e7\u00e3o Connect|API. Sem telemetria.",
  "key": "",
  "permissions": [
    "scripting"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "<all_urls>"
    ]
  }
}
