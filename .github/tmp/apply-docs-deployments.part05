text=text.replace('          canonical="$(grep \'^ARGWS_CONNECT_API_IMAGE=\' deploy/canonical/env.example | cut -d= -f2-)"', '          canonical="$(grep \'^ARGWS_CONNECT_API_IMAGE=\' deploy/canonical/env.example | cut -d= -f2-)"\n          prod_docs="$(grep \'^ARGWS_CONNECT_DOCS_IMAGE=\' deploy/production/env.example | cut -d= -f2-)"\n          develop_docs="$(grep \'^ARGWS_CONNECT_DOCS_IMAGE=\' deploy/develop/env.example | cut -d= -f2-)"\n          canonical_docs="$(grep \'^ARGWS_CONNECT_DOCS_IMAGE=\' deploy/canonical/env.example | cut -d= -f2-)"')
text=text.replace('          [[ "$canonical" =~ ^ghcr\\.io/wkarts/argws-connect-api:[0-9]+\\.[0-9]+\\.[0-9]+$ ]]', '          [[ "$canonical" =~ ^ghcr\\.io/wkarts/argws-connect-api:[0-9]+\\.[0-9]+\\.[0-9]+$ ]]\n          [[ "$prod_docs" == "ghcr.io/wkarts/argws-connect-docs:latest" ]]\n          [[ "$develop_docs" == "ghcr.io/wkarts/argws-connect-docs:develop" ]]\n          [[ "$canonical_docs" =~ ^ghcr\\.io/wkarts/argws-connect-docs:[0-9]+\\.[0-9]+\\.[0-9]+$ ]]\n          [[ "${canonical##*:}" == "${canonical_docs##*:}" ]]')
# validate docs develop workflow
needle='''          grep -q 'refs/heads/develop' .github/workflows/ghcr-publish-application.yml\n'''
repl=needle+'''          grep -q 'branches: \[develop\]' .github/workflows/ghcr-publish-docs.yml\n          grep -q 'argws-connect-docs' .github/workflows/ghcr-publish-docs.yml\n          grep -q 'docker buildx imagetools create -t "${repo}:develop"' .github/workflows/ghcr-publish-docs.yml\n          grep -q 'refs/heads/develop' .github/workflows/ghcr-publish-docs.yml\n'''
text=text.replace(needle,repl)
text=text.replace("          grep -q 'component: \\[api, manager\\]' .github/workflows/auto-version-release.yml", "          grep -q 'component: \\[api, manager, docs\\]' .github/workflows/auto-version-release.yml")
text=text.replace("          grep -q 'image: argws-connect-manager' .github/workflows/auto-version-release.yml", "          grep -q 'image: argws-connect-manager' .github/workflows/auto-version-release.yml\n          grep -q 'image: argws-connect-docs' .github/workflows/auto-version-release.yml")
text=text.replace("          grep -Eq 'argws-connect-api:[0-9]+\\.[0-9]+\\.[0-9]+' deploy/canonical/compose.yaml", "          grep -Eq 'argws-connect-api:[0-9]+\\.[0-9]+\\.[0-9]+' deploy/canonical/compose.yaml\n          grep -q 'argws-connect-docs:latest' deploy/production/compose.yaml\n          grep -q 'argws-connect-docs:develop' deploy/develop/compose.yaml\n          grep -Eq 'argws-connect-docs:[0-9]+\\.[0-9]+\\.[0-9]+' deploy/canonical/compose.yaml")
text=text.replace("          grep -q '^ARGWS_CONNECT_API_HOST_PORT=38083$' deploy/canonical/env.example", "          grep -q '^ARGWS_CONNECT_API_HOST_PORT=38083$' deploy/canonical/env.example\n          grep -q '^ARGWS_CONNECT_DOCS_HOST_PORT=38180$' deploy/production/env.example\n          grep -q '^ARGWS_CONNECT_DOCS_HOST_PORT=38182$' deploy/develop/env.example\n          grep -q '^ARGWS_CONNECT_DOCS_HOST_PORT=38183$' deploy/canonical/env.example")
write(path,text)

# Development flow references
path='DEVELOPMENT-FLOW.md'; text=(ROOT/path).read_text()
text=text.replace('ghcr.io/wkarts/argws-connect-manager:develop', 'ghcr.io/wkarts/argws-connect-manager:develop\nghcr.io/wkarts/argws-connect-docs:develop',1)
text=text.replace('A stack `deploy/develop` consome exclusivamente `argws-connect-api:develop`.', 'A stack `deploy/develop` consome `argws-connect-api:develop` e `argws-connect-docs:develop`.')
text=text.replace('6. constrói API e Manager em `amd64` e `arm64`;', '6. constrói API, Manager e DOCs em `amd64` e `arm64`;')
write(path,text)

# Release automation basic docs mention
path='RELEASE-AUTOMATION.md'; text=(ROOT/path).read_text()
text=text.replace('API/Manager', 'API/Manager/DOCs')
text=text.replace('API e Manager', 'API, Manager e DOCs')
text=text.replace('argws-connect-manager', 'argws-connect-manager')
if 'argws-connect-docs' not in text:
    text += '\n\n## Connect|API DOCs\n\nA release de `main` publica `ghcr.io/wkarts/argws-connect-docs` com a mesma SemVer da API, incluindo `X.Y.Z`, `X.Y`, `X` e `latest`. O `deploy/canonical` mantém API e DOCs pinados na mesma versão.\n'
write(path,text)

# ensure cloudpanel/dockge duplicate envs identical
assert (ROOT/'deploy/cloudpanel/env.example').read_text()==(ROOT/'deploy/cloudpanel/.env.example').read_text()
assert (ROOT/'deploy/dockge/env.example').read_text()==(ROOT/'deploy/dockge/.env.example').read_text()

# record changed
print('\n'.join(changed))
print('COUNT',len(changed))
