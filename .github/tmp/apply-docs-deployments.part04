text=text.replace("              for resource, expected_image in infra_images.items():", "              docs_service = full['services'][f'docs-{suffix}']\n              docs_image = docs_service['image']\n              if 'docs_image' in contract:\n                  assert docs_image == contract['docs_image'], f'{stack}: imagem DOCs incorreta: {docs_image}'\n              else:\n                  assert re.fullmatch(contract['docs_image_regex'], docs_image), (\n                      f'{stack}: canonical DOCs deve usar SemVer: {docs_image}'\n                  )\n                  assert api_image.rsplit(':', 1)[1] == docs_image.rsplit(':', 1)[1], (\n                      f'{stack}: API e DOCs canonical devem usar a mesma SemVer'\n                  )\n\n              for resource, expected_image in infra_images.items():")
text=text.replace("              assert int(env['ARGWS_CONNECT_API_HOST_PORT']) == contract['port']\n", "              assert int(env['ARGWS_CONNECT_API_HOST_PORT']) == contract['port']\n              assert int(env['ARGWS_CONNECT_DOCS_HOST_PORT']) == contract['docs_port']\n")
text=text.replace("'COMPOSE_PROJECT_NAME', 'ARGWS_CONNECT_NETWORK_NAME', 'ARGWS_CONNECT_API_HOST_PORT',\n              'ARGWS_CONNECT_API_IMAGE'", "'COMPOSE_PROJECT_NAME', 'ARGWS_CONNECT_NETWORK_NAME', 'ARGWS_CONNECT_API_HOST_PORT',\n              'ARGWS_CONNECT_DOCS_HOST_PORT', 'ARGWS_CONNECT_API_IMAGE', 'ARGWS_CONNECT_DOCS_IMAGE'")
text=text.replace("          assert prod['ARGWS_CONNECT_API_IMAGE'] == 'ghcr.io/wkarts/argws-connect-api:latest'", "          assert prod['ARGWS_CONNECT_API_IMAGE'] == 'ghcr.io/wkarts/argws-connect-api:latest'\n          assert prod['ARGWS_CONNECT_DOCS_IMAGE'] == 'ghcr.io/wkarts/argws-connect-docs:latest'")
text=text.replace("          assert dev['ARGWS_CONNECT_API_IMAGE'] == 'ghcr.io/wkarts/argws-connect-api:develop'", "          assert dev['ARGWS_CONNECT_API_IMAGE'] == 'ghcr.io/wkarts/argws-connect-api:develop'\n          assert dev['ARGWS_CONNECT_DOCS_IMAGE'] == 'ghcr.io/wkarts/argws-connect-docs:develop'")
text=text.replace("          assert re.fullmatch(r'ghcr\\.io/wkarts/argws-connect-api:\\d+\\.\\d+\\.\\d+', canonical['ARGWS_CONNECT_API_IMAGE'])", "          assert re.fullmatch(r'ghcr\\.io/wkarts/argws-connect-api:\\d+\\.\\d+\\.\\d+', canonical['ARGWS_CONNECT_API_IMAGE'])\n          assert re.fullmatch(r'ghcr\\.io/wkarts/argws-connect-docs:\\d+\\.\\d+\\.\\d+', canonical['ARGWS_CONNECT_DOCS_IMAGE'])\n          assert canonical['ARGWS_CONNECT_API_IMAGE'].rsplit(':',1)[1] == canonical['ARGWS_CONNECT_DOCS_IMAGE'].rsplit(':',1)[1]")
# Auxiliary validation step before scripts
aux='''\n      - name: Validate homologation, CloudPanel and Dockge DOCs contract\n        shell: bash\n        run: |\n          set -euo pipefail\n          python3 - <<'PY'\n          import json, subprocess\n          from pathlib import Path\n\n          cases = [\n              ('homologation', 'deploy/homologation/compose.yaml', 'deploy/homologation/env.example', 'docs', 38181, 'ghcr.io/wkarts/argws-connect-docs:develop'),\n              ('cloudpanel', 'deploy/cloudpanel/docker-compose.yml', 'deploy/cloudpanel/env.example', 'docs', 38180, 'ghcr.io/wkarts/argws-connect-docs:latest'),\n              ('dockge', 'deploy/dockge/compose.yaml', 'deploy/dockge/env.example', 'docs', 38180, 'ghcr.io/wkarts/argws-connect-docs:latest'),\n          ]\n          def env_values(path):\n              out = {}\n              for raw in Path(path).read_text().splitlines():\n                  line = raw.strip()\n                  if line and not line.startswith('#') and '=' in line:\n                      k,v=line.split('=',1); out[k]=v\n              return out\n          for name, compose, envfile, service, port, image in cases:\n              cfg=json.loads(subprocess.check_output(['docker','compose','-f',compose,'config','--format','json'], text=True))\n              docs=cfg['services'][service]\n              ports=docs.get('ports',[])\n              assert len(ports)==1 and int(ports[0]['target'])==8080 and int(ports[0]['published'])==port, f'{name}: porta DOCs inválida'\n              assert docs['image']==image, f'{name}: imagem DOCs inválida: {docs["image"]}'\n              env=env_values(envfile)\n              assert int(env['ARGWS_CONNECT_DOCS_HOST_PORT'])==port\n              assert env['ARGWS_CONNECT_DOCS_IMAGE']==image\n          print('Auxiliary DOCs deployment contract OK')\n          PY\n\n'''
text=text.replace('      - name: Validate deployment scripts\n', aux+'      - name: Validate deployment scripts\n')
# runtime image checks only develop docs to avoid race with main release
text=text.replace('            ghcr.io/wkarts/argws-connect-api:develop \\\n            "$canonical_image"', '            ghcr.io/wkarts/argws-connect-api:develop \\\n            ghcr.io/wkarts/argws-connect-docs:develop \\\n            "$canonical_image"')
write(path,text)

# image promotion integrity
path='.github/workflows/image-promotion-integrity.yml'; text=(ROOT/path).read_text()
text=text.replace('      - ".github/workflows/ghcr-publish-application.yml"', '      - ".github/workflows/ghcr-publish-application.yml"\n      - ".github/workflows/ghcr-publish-docs.yml"')
# second occurrence push
text=text.replace('      - ".github/workflows/ghcr-publish-application.yml"\n      - ".github/workflows/ghcr-publish-docs.yml"\n      - ".github/workflows/auto-version-release.yml"', '      - ".github/workflows/ghcr-publish-application.yml"\n      - ".github/workflows/ghcr-publish-docs.yml"\n      - ".github/workflows/auto-version-release.yml"',1)
