            text=text.replace(api_image, api_image+f"\nARGWS_CONNECT_DOCS_IMAGE=ghcr.io/wkarts/argws-connect-docs:{cfg['tag']}", 1)
        write(envfile,text)

# preflight scripts
for name in ['production','homologation','develop','canonical']:
    path=f'deploy/{name}/preflight.sh'; p=ROOT/path; text=p.read_text()
    if 'ARGWS_CONNECT_DOCS_IMAGE' not in text:
        if 'image_vars=(' in text and '\n  ARGWS_CONNECT_API_IMAGE\n' in text:
            text=text.replace('  ARGWS_CONNECT_API_IMAGE\n', '  ARGWS_CONNECT_API_IMAGE\n  ARGWS_CONNECT_DOCS_IMAGE\n',1)
        else:
            text=text.replace('image_vars=(ARGWS_CONNECT_API_IMAGE ', 'image_vars=(ARGWS_CONNECT_API_IMAGE ARGWS_CONNECT_DOCS_IMAGE ',1)
    if name=='production' and 'docs_image=' not in text:
        text=text.replace('api_image="$(get_value ARGWS_CONNECT_API_IMAGE)"\n[[ "$api_image" == "ghcr.io/wkarts/argws-connect-api:latest" ]] || { echo "ERRO: production deve usar :latest."; exit 1; }',
                          'api_image="$(get_value ARGWS_CONNECT_API_IMAGE)"\ndocs_image="$(get_value ARGWS_CONNECT_DOCS_IMAGE)"\n[[ "$api_image" == "ghcr.io/wkarts/argws-connect-api:latest" ]] || { echo "ERRO: production deve usar API :latest."; exit 1; }\n[[ "$docs_image" == "ghcr.io/wkarts/argws-connect-docs:latest" ]] || { echo "ERRO: production deve usar DOCs :latest."; exit 1; }')
    if name=='develop' and 'docs_image=' not in text:
        text=text.replace('api_image="$(get_value ARGWS_CONNECT_API_IMAGE)"\n[[ "$api_image" == "ghcr.io/wkarts/argws-connect-api:develop" ]] || { echo "ERRO: develop deve usar :develop."; exit 1; }',
                          'api_image="$(get_value ARGWS_CONNECT_API_IMAGE)"\ndocs_image="$(get_value ARGWS_CONNECT_DOCS_IMAGE)"\n[[ "$api_image" == "ghcr.io/wkarts/argws-connect-api:develop" ]] || { echo "ERRO: develop deve usar API :develop."; exit 1; }\n[[ "$docs_image" == "ghcr.io/wkarts/argws-connect-docs:develop" ]] || { echo "ERRO: develop deve usar DOCs :develop."; exit 1; }')
    if name=='canonical' and 'docs_image=' not in text:
        text=text.replace('api_image="$(get_value ARGWS_CONNECT_API_IMAGE)"\n[[ "$api_image" =~ ^ghcr\\.io/wkarts/argws-connect-api:[0-9]+\\.[0-9]+\\.[0-9]+$ ]] || { echo "ERRO: canonical exige SemVer X.Y.Z."; exit 1; }',
                          'api_image="$(get_value ARGWS_CONNECT_API_IMAGE)"\ndocs_image="$(get_value ARGWS_CONNECT_DOCS_IMAGE)"\n[[ "$api_image" =~ ^ghcr\\.io/wkarts/argws-connect-api:[0-9]+\\.[0-9]+\\.[0-9]+$ ]] || { echo "ERRO: canonical exige API SemVer X.Y.Z."; exit 1; }\n[[ "$docs_image" =~ ^ghcr\\.io/wkarts/argws-connect-docs:[0-9]+\\.[0-9]+\\.[0-9]+$ ]] || { echo "ERRO: canonical exige DOCs SemVer X.Y.Z."; exit 1; }\n[[ "${api_image##*:}" == "${docs_image##*:}" ]] || { echo "ERRO: canonical exige a mesma SemVer para API e DOCs."; exit 1; }')
    if name=='homologation' and 'docs_image=' not in text:
        needle='''api_image="$(get_value ARGWS_CONNECT_API_IMAGE)"\nif [[ "$api_image" != "ghcr.io/wkarts/argws-connect-api:develop" ]]; then\n  echo "ERRO: homologacao deve usar exclusivamente ghcr.io/wkarts/argws-connect-api:develop"\n  echo "Imagem atual: ${api_image:-<vazia>}"\n  exit 1\nfi'''
        repl=needle+'''\n\ndocs_image="$(get_value ARGWS_CONNECT_DOCS_IMAGE)"\nif [[ "$docs_image" != "ghcr.io/wkarts/argws-connect-docs:develop" ]]; then\n  echo "ERRO: homologacao deve usar exclusivamente ghcr.io/wkarts/argws-connect-docs:develop"\n  echo "Imagem DOCs atual: ${docs_image:-<vazia>}"\n  exit 1\nfi'''
        text=text.replace(needle,repl)
    write(path,text)

# deploy scripts: expose both endpoints in operator output
for name, port in [('production',38180),('homologation',38181),('develop',38182),('canonical',38183)]:
    path=f'deploy/{name}/deploy.sh'; p=ROOT/path; text=p.read_text()
    if 'DOCs local:' not in text:
        text=text.rstrip()+f'\necho "DOCs local: http://127.0.0.1:{port}"\n'
    write(path,text)

# CloudPanel deploy output
p=ROOT/'deploy/cloudpanel/deploy.sh'; text=p.read_text().replace('Stack iniciada. Somente a porta da API e publicada no host.','Stack iniciada. API e Connect|API DOCs possuem portas locais dedicadas no host.')
if 'DOCs local:' not in text:
    text=text.replace('docker compose ps\n','docker compose ps\necho "DOCs local: http://127.0.0.1:${ARGWS_CONNECT_DOCS_HOST_PORT:-38180}"\n')
write('deploy/cloudpanel/deploy.sh',text)

# README replacements - concise and environment-specific
readme_data={
'production': ('https://api.connect.argws.com.br',38080,38180,'latest'),
'develop': ('https://d.api.connect.argws.com.br',38082,38182,'develop'),
'canonical': ('https://c.api.connect.argws.com.br',38083,38183,'1.0.16'),
}
for name,(url,ap,dp,tag) in readme_data.items():
    path=f'deploy/{name}/README.md'; text=(ROOT/path).read_text()
    text=text.replace(f'- Porta local padrão: `{ap}`',f'- Porta local API: `{ap}`\n    - Porta local DOCs: `{dp}`')
    text=text.replace(f'- API image: `ghcr.io/wkarts/argws-connect-api:{tag}`',f'- API image: `ghcr.io/wkarts/argws-connect-api:{tag}`\n    - DOCs image: `ghcr.io/wkarts/argws-connect-docs:{tag}`')
    text=text.replace('- Única porta publicada: API','- Portas locais publicadas: API + Connect|API DOCs')
    text=text.replace('- Serviços core: API, PostgreSQL, Redis, RabbitMQ e MinIO','- Serviços core: API, Connect|API DOCs, PostgreSQL, Redis, RabbitMQ e MinIO')
    write(path,text)

# Homologation README
path='deploy/homologation/README.md'; text=(ROOT/path).read_text()
text=text.replace('ARGWS Connect API\n├── PostgreSQL','ARGWS Connect API\n├── Connect|API DOCs\n├── PostgreSQL')
text=text.replace('Somente a API publica `127.0.0.1:38081`; `/manager`, `/health`, `/metrics`, WebSocket e webhooks usam esse mesmo endpoint.', 'A API publica `127.0.0.1:38081` e o Connect|API DOCs publica `127.0.0.1:38181`. `/manager`, `/health`, `/metrics`, WebSocket e webhooks da aplicação continuam no endpoint da API.')
