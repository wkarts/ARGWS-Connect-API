text=text.replace('console.log(`Production tracks :latest. Canonical pinned to ${canonicalImage}.`);', 'console.log(`Production tracks :latest. Canonical API pinned to ${canonicalImage}.`);\nconsole.log(`Canonical DOCs pinned to ${canonicalDocsImage}.`);')
write(path,text)

# auto release includes docs
path='.github/workflows/auto-version-release.yml'; text=(ROOT/path).read_text()
text=text.replace('      - run: npm run build\n', '      - run: npm run build\n      - run: npm run docs:check\n',1)
text=text.replace('component: [api, manager]', 'component: [api, manager, docs]',1)
needle='''          - component: manager\n            context: ./manager\n            dockerfile: ./manager/Dockerfile\n            image: argws-connect-manager\n'''
repl=needle+'''          - component: docs\n            context: .\n            dockerfile: ./docs/Dockerfile\n            image: argws-connect-docs\n'''
text=text.replace(needle,repl,1)
needle2='''          - component: manager\n            image: argws-connect-manager\n'''
repl2=needle2+'''          - component: docs\n            image: argws-connect-docs\n'''
text=text.replace(needle2,repl2,1)
text=text.replace('echo "ghcr.io/${{ github.repository_owner }}/argws-connect-manager:${version}"', 'echo "ghcr.io/${{ github.repository_owner }}/argws-connect-manager:${version}"\n            echo "ghcr.io/${{ github.repository_owner }}/argws-connect-docs:${version}"')
write(path,text)

# deployment integrity: official + auxiliary stacks
path='.github/workflows/deployment-integrity.yml'; text=(ROOT/path).read_text()
text=text.replace('name: Official Stacks / Services / Single Port','name: Official Stacks / Services / API + DOCs')
text=text.replace("          cp deploy/canonical/env.example deploy/canonical/.env\n", "          cp deploy/canonical/env.example deploy/canonical/.env\n          cp deploy/homologation/env.example deploy/homologation/.env\n          cp deploy/cloudpanel/env.example deploy/cloudpanel/.env\n          cp deploy/dockge/env.example deploy/dockge/.env\n")
text=text.replace('for stack in production develop canonical; do', 'for stack in production develop canonical homologation; do')
text=text.replace('docker compose -f "deploy/${stack}/compose.yaml" config >/dev/null', 'compose_file="deploy/${stack}/compose.yaml"\n            docker compose -f "$compose_file" config >/dev/null')
text=text.replace('docker compose --profile \'*\' -f "deploy/${stack}/compose.yaml" config >/dev/null', 'docker compose --profile \'*\' -f "$compose_file" config >/dev/null')
# add cloudpanel/dockge syntax lines after loop
text=text.replace('          done\n\n      - name: Enforce official deployment contract', '          done\n          docker compose -f deploy/cloudpanel/docker-compose.yml config >/dev/null\n          docker compose --profile \'*\' -f deploy/cloudpanel/docker-compose.yml config >/dev/null\n          docker compose -f deploy/dockge/compose.yaml config >/dev/null\n          docker compose --profile \'*\' -f deploy/dockge/compose.yaml config >/dev/null\n\n      - name: Enforce official deployment contract',1)
# official stack contracts docs fields
text=text.replace("'port': 38080,\n                  'image': 'ghcr.io/wkarts/argws-connect-api:latest',", "'port': 38080,\n                  'docs_port': 38180,\n                  'image': 'ghcr.io/wkarts/argws-connect-api:latest',\n                  'docs_image': 'ghcr.io/wkarts/argws-connect-docs:latest',")
text=text.replace("'port': 38082,\n                  'image': 'ghcr.io/wkarts/argws-connect-api:develop',", "'port': 38082,\n                  'docs_port': 38182,\n                  'image': 'ghcr.io/wkarts/argws-connect-api:develop',\n                  'docs_image': 'ghcr.io/wkarts/argws-connect-docs:develop',")
text=text.replace("'port': 38083,\n                  'image_regex': r'ghcr\\.io/wkarts/argws-connect-api:\\d+\\.\\d+\\.\\d+',", "'port': 38083,\n                  'docs_port': 38183,\n                  'image_regex': r'ghcr\\.io/wkarts/argws-connect-api:\\d+\\.\\d+\\.\\d+',\n                  'docs_image_regex': r'ghcr\\.io/wkarts/argws-connect-docs:\\d+\\.\\d+\\.\\d+',")
text=text.replace("core_resources = ('api', 'postgres', 'redis', 'rabbitmq', 'minio')", "core_resources = ('api', 'docs', 'postgres', 'redis', 'rabbitmq', 'minio')")
old='''                  if service_name == f'api-{suffix}':\n                      assert len(ports) == 1, f'{stack}: API deve publicar exatamente uma porta'\n                      assert int(ports[0]['target']) == 8080, f'{stack}: target interno deve ser 8080'\n                      assert int(ports[0]['published']) == contract['port'], (\n                          f'{stack}: porta esperada {contract["port"]}'\n                      )\n                  else:\n                      assert not ports, f'{stack}: somente API pode publicar porta: {service_name}'\n'''
new='''                  if service_name == f'api-{suffix}':\n                      assert len(ports) == 1, f'{stack}: API deve publicar exatamente uma porta'\n                      assert int(ports[0]['target']) == 8080, f'{stack}: target API deve ser 8080'\n                      assert int(ports[0]['published']) == contract['port'], (\n                          f'{stack}: porta API esperada {contract["port"]}'\n                      )\n                  elif service_name == f'docs-{suffix}':\n                      assert len(ports) == 1, f'{stack}: DOCs deve publicar exatamente uma porta'\n                      assert int(ports[0]['target']) == 8080, f'{stack}: target DOCs deve ser 8080'\n                      assert int(ports[0]['published']) == contract['docs_port'], (\n                          f'{stack}: porta DOCs esperada {contract["docs_port"]}'\n                      )\n                  else:\n                      assert not ports, f'{stack}: infraestrutura não pode publicar porta: {service_name}'\n'''
text=text.replace(old,new)
