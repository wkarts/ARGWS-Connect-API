# Connect|API Manager — política de idioma da reconstrução
# pt-BR é o único idioma habilitado por padrão.

MANAGER_DEFAULT_LOCALE=pt-BR
MANAGER_ENABLE_EXTRA_LOCALES=false

# Idiomas legados podem continuar no código, mas só ficam disponíveis
# quando MANAGER_ENABLE_EXTRA_LOCALES=true.
MANAGER_EXTRA_LOCALES=en-US,es-ES,fr-FR
