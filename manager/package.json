{
  "name": "connect-api-web",
  "private": true,
  "version": "1.0.21-ui.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:language": "node scripts/check-visible-language.mjs",
    "test": "npm run check:language && npm run check:sfc && npm run build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check:sfc": "node scripts/check-sfc-structure.mjs"
  },
  "dependencies": {
    "pinia": "3.0.3",
    "qrcode": "1.5.4",
    "vue": "3.5.21",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-vue": "6.0.1",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vue-tsc": "3.0.6"
  }
}
