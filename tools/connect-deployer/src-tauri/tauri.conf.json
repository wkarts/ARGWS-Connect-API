{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARGWS Connect Deployer",
  "version": "2.0.0",
  "identifier": "br.com.argws.connect.deployer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARGWS Connect|API Deployer",
        "width": 1280,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Implantador SSH do ARGWS Connect|API",
    "longDescription": "Desktop Deployer em Tauri/Rust para implantação segura do ARGWS Connect|API em VPS Linux sem Python remoto.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
