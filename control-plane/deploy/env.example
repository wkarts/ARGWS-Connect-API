COMPOSE_PROJECT_NAME=argws-connect-control-plane
TZ=America/Bahia
CONTROL_PLANE_BIND_ADDRESS=127.0.0.1
CONTROL_PLANE_HOST_PORT=39100
CONTROL_PLANE_DOMAIN=control.connect.argws.com.br
CONTROL_PLANE_API_IMAGE=ghcr.io/wkarts/argws-connect-control-plane-api:phase2
CONTROL_PLANE_WEB_IMAGE=ghcr.io/wkarts/argws-connect-control-plane-web:phase2
PLATFORM_GATEWAY_IMAGE=ghcr.io/wkarts/argws-platform-nginx:1.27-alpine
PLATFORM_POSTGRES_IMAGE=ghcr.io/wkarts/argws-platform-postgres:17
PLATFORM_REDIS_IMAGE=ghcr.io/wkarts/argws-platform-redis:8
PLATFORM_RABBITMQ_IMAGE=ghcr.io/wkarts/argws-platform-rabbitmq:4-management
PLATFORM_NATS_IMAGE=ghcr.io/wkarts/argws-platform-nats:2.10-alpine
PLATFORM_PROMETHEUS_IMAGE=ghcr.io/wkarts/argws-platform-prometheus:latest
PLATFORM_GRAFANA_IMAGE=ghcr.io/wkarts/argws-platform-grafana:latest
PLATFORM_LOG_AGENT_IMAGE=ghcr.io/wkarts/argws-platform-vector:latest
POSTGRES_DB=argws_connect_control
POSTGRES_USER=argws_control
POSTGRES_PASSWORD=CHANGE_ME_CONTROL_POSTGRES
DATABASE_URL=postgresql+asyncpg://argws_control:CHANGE_ME_CONTROL_POSTGRES@postgres:5432/argws_connect_control
REDIS_URL=redis://redis:6379/0
RABBITMQ_DEFAULT_VHOST=argws_control
RABBITMQ_DEFAULT_USER=argws_control
RABBITMQ_DEFAULT_PASS=CHANGE_ME_CONTROL_RABBITMQ
RABBITMQ_URL=amqp://argws_control:CHANGE_ME_CONTROL_RABBITMQ@rabbitmq:5672/argws_control
NATS_URL=nats://nats:4222
GRAFANA_ADMIN_USER=argws_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CONNECT_API_BASE_DOMAIN=connect.argws.com.br
