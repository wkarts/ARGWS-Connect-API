# Connect|API Platform Domain Agent — host Nginx/Certbot
# Use o Control Plane do ambiente desejado (production ou develop).
CONTROL_PLANE_URL=https://control.connect.argws.com.br
DOMAIN_RECONCILIATION_TOKEN=CHANGE_ME_DOMAIN_RECONCILIATION_TOKEN
NGINX_INCLUDE_DIR=/etc/nginx/conf.d/connect-api-tenants
ACME_WEBROOT=/var/www/letsencrypt
GATEWAY_UPSTREAM=http://127.0.0.1:38800
ACME_EMAIL=
ACME_STAGING=false
CERTBOT_BIN=/usr/bin/certbot
NGINX_BIN=/usr/sbin/nginx
NGINX_RELOAD_COMMAND=systemctl reload nginx
