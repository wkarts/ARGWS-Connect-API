[Unit]
Description=Connect|API Platform Domain and SSL Reconciliation
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/connect-api-domain-agent.env
ExecStart=/usr/bin/python3 /opt/argws-connect-api/platform/scripts/domain_agent.py
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/nginx /etc/letsencrypt /var/www/letsencrypt

[Install]
WantedBy=multi-user.target
