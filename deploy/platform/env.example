# ============================================================================
# Connect|API — Deployment Profiles
# Versionamento vem SEMPRE do VERSION/package.json da raiz.
# ============================================================================
COMPOSE_PROJECT_NAME=argws-connect-platform
CONNECT_API_VERSION=1.0.16
TZ=America/Bahia
ARGWS_CONNECT_NETWORK_NAME=argws-connect-platform-net
ARGWS_CONNECT_BIND_ADDRESS=127.0.0.1
ARGWS_CONNECT_API_HOST_PORT=38080
ARGWS_CONNECT_DOCS_HOST_PORT=38082
PLATFORM_GATEWAY_BIND_ADDRESS=127.0.0.1
PLATFORM_GATEWAY_PORT=38800

# Engine images (canonical API lifecycle)
ARGWS_CONNECT_API_IMAGE=ghcr.io/wkarts/argws-connect-api:latest
ARGWS_CONNECT_DOCS_IMAGE=ghcr.io/wkarts/argws-connect-docs:latest
ARGWS_CONNECT_POSTGRES_IMAGE=ghcr.io/wkarts/argws-connect-postgres:15
ARGWS_CONNECT_REDIS_IMAGE=ghcr.io/wkarts/argws-connect-redis:latest
ARGWS_CONNECT_RABBITMQ_IMAGE=ghcr.io/wkarts/argws-connect-rabbitmq:management
ARGWS_CONNECT_MINIO_IMAGE=ghcr.io/wkarts/argws-connect-minio:latest

# Platform images — published with the same Connect|API version/tag
ARGWS_CONNECT_PLATFORM_API_IMAGE=ghcr.io/wkarts/argws-connect-platform-api:latest
ARGWS_CONNECT_PLATFORM_WEB_IMAGE=ghcr.io/wkarts/argws-connect-platform-web:latest
ARGWS_CONNECT_PLATFORM_GATEWAY_IMAGE=ghcr.io/wkarts/argws-connect-platform-gateway:latest
ARGWS_CONNECT_PLATFORM_POSTGRES_IMAGE=ghcr.io/wkarts/argws-connect-postgres:17

# Engine credentials/infrastructure
POSTGRES_DATABASE=argws_connect_api
POSTGRES_USERNAME=argws_connect
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
RABBITMQ_USER=argws_connect
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_VHOST=argws_connect
MINIO_ROOT_USER=argws_connect
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
AUTHENTICATION_API_KEY=CHANGE_ME_GENERATE_A_STRONG_API_KEY

ARGWS_CONNECT_INSTANCES_DATA_PATH=./volumes/instances
ARGWS_CONNECT_POSTGRES_DATA_PATH=./volumes/postgres
ARGWS_CONNECT_REDIS_DATA_PATH=./volumes/redis
ARGWS_CONNECT_RABBITMQ_DATA_PATH=./volumes/rabbitmq
ARGWS_CONNECT_MINIO_DATA_PATH=./volumes/minio

# Platform database/state
PLATFORM_POSTGRES_DB=connect_api_platform
PLATFORM_POSTGRES_USER=connect_api_platform
PLATFORM_POSTGRES_PASSWORD=CHANGE_ME_PLATFORM_POSTGRES_PASSWORD
ARGWS_CONNECT_PLATFORM_POSTGRES_DATA_PATH=./volumes/platform-postgres

# Platform security
PLATFORM_APP_ENV=production
PLATFORM_APP_SECRET_KEY=CHANGE_ME_PLATFORM_APP_SECRET_KEY_32_CHARS
PLATFORM_FIELD_ENCRYPTION_KEY=CHANGE_ME_PLATFORM_FIELD_ENCRYPTION_KEY
PLATFORM_INTERNAL_SERVICES_PASSWORD=CHANGE_ME_PLATFORM_INTERNAL_PASSWORD
PLATFORM_ADMIN_NAME=Administrador da Plataforma
PLATFORM_ADMIN_EMAIL=admin@connect.example.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_PLATFORM_ADMIN_PASSWORD
DEMO_TENANT_ADMIN_PASSWORD=CHANGE_ME_DEMO_ADMIN_PASSWORD
DOMAIN_RECONCILIATION_TOKEN=CHANGE_ME_DOMAIN_TOKEN

# Domains
PLATFORM_DOMAIN=connect.example.com
CONTROL_PLANE_HOST=control.connect.example.com
ADMIN_HOST=admin.connect.example.com
PARTNER_PLANE_HOST=partner.connect.example.com
API_HOST=api.connect.example.com
DOCS_HOST=docs.connect.example.com
DEMO_HOST=demo.connect.example.com
TENANT_DOMAIN_ROOT=connect.example.com
PUBLIC_SCHEME=https
PLATFORM_TRUSTED_HOSTS=connect.example.com,control.connect.example.com,admin.connect.example.com,partner.connect.example.com,api.connect.example.com,docs.connect.example.com,demo.connect.example.com,.connect.example.com,localhost,127.0.0.1
PLATFORM_CORS_ORIGINS=https://connect.example.com,https://control.connect.example.com,https://admin.connect.example.com,https://partner.connect.example.com,https://demo.connect.example.com
# --------------------------------------------------------------------------
# Platform · provisionamento, observabilidade, backups, DNS e ACME
# Storage usado pelo Control Plane para buckets isolados por tenant.
# Vazio = usa o MinIO da própria stack; preencha para S3/S3-compatible externo.
PLATFORM_S3_ENDPOINT_URL=
PLATFORM_S3_PUBLIC_ENDPOINT_URL=
PLATFORM_S3_REGION=
PLATFORM_S3_ACCESS_KEY=
PLATFORM_S3_SECRET_KEY=
PLATFORM_S3_USE_SSL=false
PLATFORM_S3_BUCKET_PREFIX=

# --------------------------------------------------------------------------
ARGWS_CONNECT_DOCKER_PROXY_IMAGE=ghcr.io/wkarts/argws-connect-docker-proxy:v0.5.0
ARGWS_CONNECT_PROMETHEUS_IMAGE=ghcr.io/wkarts/argws-connect-prometheus:v3.5.0
ARGWS_CONNECT_GRAFANA_IMAGE=ghcr.io/wkarts/argws-connect-grafana:12.1.0
ARGWS_CONNECT_PLATFORM_ACME_IMAGE=ghcr.io/wkarts/argws-connect-platform-acme:latest
ARGWS_CONNECT_PLATFORM_CLOUDPANEL_AGENT_IMAGE=ghcr.io/wkarts/argws-connect-platform-cloudpanel-agent:latest

ARGWS_CONNECT_PLATFORM_BACKUPS_DATA_PATH=./volumes/platform-backups
ARGWS_CONNECT_PLATFORM_PROMETHEUS_DATA_PATH=./volumes/platform-prometheus
ARGWS_CONNECT_PLATFORM_GRAFANA_DATA_PATH=./volumes/platform-grafana
ARGWS_CONNECT_PLATFORM_ACME_DATA_PATH=./volumes/platform-acme
ARGWS_CONNECT_PLATFORM_CERTS_DATA_PATH=./volumes/platform-certs
ARGWS_CONNECT_PLATFORM_CLOUDPANEL_STATE_PATH=./volumes/platform-cloudpanel-agent
DOCKER_SOCKET_PATH=/var/run/docker.sock
PLATFORM_LOG_LEVEL=INFO
RUNTIME_LOG_RETENTION_DAYS=30

CLOUDFLARE_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=example.com
CLOUDFLARE_PROXIED=true
CLOUDFLARE_TENANT_RECORD_TARGET=connect.example.com
CLOUDFLARE_PROVISIONING_MODE=wildcard

BACKUP_ENABLED=true
BACKUP_CRON="0 2 * * *"
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
BACKUP_COMPRESS_LEVEL=9
BACKUP_ENCRYPTION_RECIPIENT=
BACKUP_UPLOAD_S3=true
BACKUP_S3_BUCKET=connect-api-platform-backups
BACKUP_GOOGLE_DRIVE_ENABLED=false
BACKUP_GOOGLE_DRIVE_REMOTE=gdrive:connect-api-platform
BACKUP_DROPBOX_ENABLED=false
BACKUP_DROPBOX_REMOTE=dropbox:connect-api-platform

PROMETHEUS_RETENTION=30d
PROMETHEUS_LIFECYCLE_ENABLED=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
GRAFANA_ROOT_URL=http://connect-grafana:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_ORG_ID=1

# Perfil opcional: docker compose --profile cloudpanel ...
ACME_DOMAIN=connect.example.com
ACME_EMAIL=
ACME_STAGING=false
ACME_DNS_SLEEP=20
ACME_CHECK_INTERVAL_SECONDS=43200
CLOUDPANEL_SITE_DOMAIN=connect.example.com
CLOUDPANEL_WILDCARD_DOMAIN=*.connect.example.com
CLOUDPANEL_SITE_USER=connectapi
CLOUDPANEL_SITE_USER_PASSWORD=
CLOUDPANEL_REVERSE_PROXY_URL=http://127.0.0.1:38800
CLOUDPANEL_SYNC_INTERVAL_SECONDS=60


# PgBouncer managed service; deployed with this compose + .env only.
ARGWS_CONNECT_PGBOUNCER_IMAGE=ghcr.io/wkarts/argws-connect-pgbouncer:latest
DATABASE_POOL_ENABLED=true
DATABASE_POOL_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT=10
PGBOUNCER_POOL_SIZE=32
PGBOUNCER_MAX_CLIENTS=256
PGBOUNCER_QUERY_WAIT_TIMEOUT=10
PGBOUNCER_QUERY_TIMEOUT=60
PGBOUNCER_SERVER_IDLE_TIMEOUT=15
POSTGRES_PGBOUNCER_ENABLED=true
PLATFORM_PGBOUNCER_CONTROL_POOL_SIZE=20
PLATFORM_PGBOUNCER_TENANT_POOL_SIZE=4
PLATFORM_PGBOUNCER_MAX_CLIENTS=256
PLATFORM_POSTGRES_MAX_CONNECTIONS=200
PLATFORM_POSTGRES_POOL_SIZE=5
PLATFORM_POSTGRES_POOL_TIMEOUT=5
PLATFORM_POSTGRES_CONNECT_TIMEOUT=5
PLATFORM_TENANT_ENGINE_CACHE_SIZE=16
PLATFORM_DATABASE_MAX_CONCURRENT_REQUESTS=16
