# ============================================================================
# Connect|API Platform — DEVELOP / STACK COMPLETA INDEPENDENTE
# Copie para .env com ./prepare-env.sh.
# Canal de imagens: develop.
# ============================================================================

COMPOSE_PROJECT_NAME=argws-connect-platform-develop
CONNECT_API_VERSION=1.0.16
TZ=America/Bahia
ARGWS_CONNECT_NETWORK_NAME=argws-connect-platform-develop-net
ARGWS_CONNECT_BIND_ADDRESS=127.0.0.1
ARGWS_CONNECT_API_HOST_PORT=38082
ARGWS_CONNECT_DOCS_HOST_PORT=38182
PLATFORM_GATEWAY_BIND_ADDRESS=127.0.0.1
PLATFORM_GATEWAY_PORT=38802
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5

# --------------------------------------------------------------------------
# Imagens — todas no canal develop da mesma linha Connect|API
# --------------------------------------------------------------------------
ARGWS_CONNECT_API_IMAGE=ghcr.io/wkarts/argws-connect-api:develop
ARGWS_CONNECT_DOCS_IMAGE=ghcr.io/wkarts/argws-connect-docs:develop
ARGWS_CONNECT_PLATFORM_API_IMAGE=ghcr.io/wkarts/argws-connect-platform-api:develop
ARGWS_CONNECT_PLATFORM_WEB_IMAGE=ghcr.io/wkarts/argws-connect-platform-web:develop
ARGWS_CONNECT_PLATFORM_GATEWAY_IMAGE=ghcr.io/wkarts/argws-connect-platform-gateway:develop
ARGWS_CONNECT_POSTGRES_IMAGE=ghcr.io/wkarts/argws-connect-postgres:15
ARGWS_CONNECT_PLATFORM_POSTGRES_IMAGE=ghcr.io/wkarts/argws-connect-postgres:17
ARGWS_CONNECT_REDIS_IMAGE=ghcr.io/wkarts/argws-connect-redis:latest
ARGWS_CONNECT_RABBITMQ_IMAGE=ghcr.io/wkarts/argws-connect-rabbitmq:management
ARGWS_CONNECT_MINIO_IMAGE=ghcr.io/wkarts/argws-connect-minio:latest

# --------------------------------------------------------------------------
# Persistência — exclusiva deste project
# --------------------------------------------------------------------------
ARGWS_CONNECT_INSTANCES_DATA_PATH=./volumes/instances
ARGWS_CONNECT_POSTGRES_DATA_PATH=./volumes/postgres
ARGWS_CONNECT_REDIS_DATA_PATH=./volumes/redis
ARGWS_CONNECT_RABBITMQ_DATA_PATH=./volumes/rabbitmq
ARGWS_CONNECT_MINIO_DATA_PATH=./volumes/minio
ARGWS_CONNECT_PLATFORM_POSTGRES_DATA_PATH=./volumes/platform-postgres
ARGWS_CONNECT_PLATFORM_CELERY_DATA_PATH=./volumes/platform-celery

# --------------------------------------------------------------------------
# Domínios DEVELOP — mesmos hosts públicos já definidos para develop
# --------------------------------------------------------------------------
SERVER_URL=https://d.api.connect.argws.com.br
ARGWS_CONNECT_DOCS_PUBLIC_URL=https://d.docs.connect.argws.com.br
PLATFORM_DOMAIN=d.connect.argws.com.br
CONTROL_PLANE_HOST=d.control.connect.argws.com.br
ADMIN_HOST=d.admin.connect.argws.com.br
PARTNER_PLANE_HOST=d.partner.connect.argws.com.br
API_HOST=d.api.connect.argws.com.br
DOCS_HOST=d.docs.connect.argws.com.br
DEMO_HOST=d.demo.connect.argws.com.br
TENANT_DOMAIN_ROOT=d.connect.argws.com.br
PUBLIC_SCHEME=https
PLATFORM_TRUSTED_HOSTS=d.connect.argws.com.br,d.control.connect.argws.com.br,d.admin.connect.argws.com.br,d.partner.connect.argws.com.br,d.api.connect.argws.com.br,d.docs.connect.argws.com.br,d.demo.connect.argws.com.br,.d.connect.argws.com.br,localhost,127.0.0.1
PLATFORM_CORS_ORIGINS=https://d.connect.argws.com.br,https://d.control.connect.argws.com.br,https://d.admin.connect.argws.com.br,https://d.partner.connect.argws.com.br,https://d.demo.connect.argws.com.br
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=false

# --------------------------------------------------------------------------
# Connect|API Engine
# --------------------------------------------------------------------------
SERVER_NAME=argws-connect-api-platform-develop
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_DISABLE_DOCS=false
SERVER_DISABLE_MANAGER=true
NODE_ENV=PROD
DOCKER_ENV=true
LANGUAGE=pt-BR
AUTHENTICATION_API_KEY=CHANGE_ME_GENERATE_A_STRONG_API_KEY
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
DEL_INSTANCE=false
DEL_TEMP_INSTANCES=false
LOG_LEVEL=ERROR,WARN,INFO,LOG,WEBHOOKS,WEBSOCKET
LOG_COLOR=true
LOG_BAILEYS=error
LOG_QRCODE=true
EVENT_EMITTER_MAX_LISTENERS=100

CONFIG_SESSION_PHONE_CLIENT=🅲🅾🅽🅽🅴🅲🆃​|🅰🅿🅸
CONFIG_SESSION_PHONE_NAME=Chrome
WHATSAPP_PROTOCOL_BROWSER_CLIENT=🅲🅾🅽🅽🅴🅲🆃​|🅰🅿🅸
WHATSAPP_PROTOCOL_BROWSER_NAME=Chrome
WHATSAPP_PROTOCOL_BROWSER_VERSION=20.0.04
QRCODE_LIMIT=30
QRCODE_COLOR='#175197'
WA_BUSINESS_TOKEN_WEBHOOK=CHANGE_ME_WHATSAPP_WEBHOOK_TOKEN
WA_BUSINESS_URL=https://graph.facebook.com
WA_BUSINESS_VERSION=v20.0
WA_BUSINESS_LANGUAGE=pt_BR

# --------------------------------------------------------------------------
# Banco operacional do Engine
# --------------------------------------------------------------------------
DATABASE_PROVIDER=postgresql
POSTGRES_DATABASE=argws_connect_platform_develop
POSTGRES_USERNAME=argws_connect
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_MAX_CONNECTIONS=300
DATABASE_CONNECTION_URI=postgresql://argws_connect:CHANGE_ME_POSTGRES_PASSWORD@postgres-argws-connect-platform-develop:5432/argws_connect_platform_develop?schema=public
DATABASE_CONNECTION_CLIENT_NAME=argws-connect-platform-develop
DATABASE_MIGRATION_MAX_ATTEMPTS=60
DATABASE_MIGRATION_RETRY_SECONDS=2
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true

# --------------------------------------------------------------------------
# Redis / RabbitMQ / MinIO
# --------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:CHANGE_ME_REDIS_PASSWORD@redis-argws-connect-platform-develop:6379/0
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=argws-connect-platform-develop
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false
CACHE_LOCAL_TTL=86400

RABBITMQ_ENABLED=true
RABBITMQ_USER=argws_connect
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_VHOST=argws_connect
RABBITMQ_DEFAULT_USER=argws_connect
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_DEFAULT_VHOST=argws_connect
RABBITMQ_URI=amqp://argws_connect:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq-argws-connect-platform-develop:5672/argws_connect
RABBITMQ_EXCHANGE_NAME=argws_connect
RABBITMQ_GLOBAL_ENABLED=true
RABBITMQ_PREFIX_KEY=argws-connect-platform-develop
RABBITMQ_EVENTS_APPLICATION_STARTUP=true
RABBITMQ_EVENTS_INSTANCE_CREATE=true
RABBITMQ_EVENTS_INSTANCE_DELETE=true
RABBITMQ_EVENTS_QRCODE_UPDATED=true
RABBITMQ_EVENTS_MESSAGES_SET=true
RABBITMQ_EVENTS_MESSAGES_UPSERT=true
RABBITMQ_EVENTS_MESSAGES_EDITED=true
RABBITMQ_EVENTS_MESSAGES_UPDATE=true
RABBITMQ_EVENTS_MESSAGES_DELETE=true
RABBITMQ_EVENTS_SEND_MESSAGE=true
RABBITMQ_EVENTS_SEND_MESSAGE_UPDATE=true
RABBITMQ_EVENTS_CONTACTS_SET=true
RABBITMQ_EVENTS_CONTACTS_UPSERT=true
RABBITMQ_EVENTS_CONTACTS_UPDATE=true
RABBITMQ_EVENTS_PRESENCE_UPDATE=true
RABBITMQ_EVENTS_CHATS_SET=true
RABBITMQ_EVENTS_CHATS_UPSERT=true
RABBITMQ_EVENTS_CHATS_UPDATE=true
RABBITMQ_EVENTS_CHATS_DELETE=true
RABBITMQ_EVENTS_GROUPS_UPSERT=true
RABBITMQ_EVENTS_GROUPS_UPDATE=true
RABBITMQ_EVENTS_GROUP_PARTICIPANTS_UPDATE=true
RABBITMQ_EVENTS_CONNECTION_UPDATE=true
RABBITMQ_EVENTS_LABELS_EDIT=true
RABBITMQ_EVENTS_LABELS_ASSOCIATION=true
RABBITMQ_EVENTS_CALL=true

MINIO_ROOT_USER=argws_connect
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
S3_ENABLED=true
S3_ACCESS_KEY=argws_connect
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=argws-connect-platform-develop
S3_PORT=9000
S3_ENDPOINT=minio-argws-connect-platform-develop
S3_REGION=us-east-1
S3_USE_SSL=false
S3_SKIP_POLICY=true
S3_SAVE_VIDEO=true

# --------------------------------------------------------------------------
# WebSocket / Webhook / métricas
# --------------------------------------------------------------------------
WEBSOCKET_ENABLED=true
WEBSOCKET_GLOBAL_EVENTS=true
WEBSOCKET_ALLOWED_HOSTS=127.0.0.1,::1,d.api.connect.argws.com.br
WEBSOCKET_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1,172.*,10.*,192.168.*

WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_APPLICATION_STARTUP=true
WEBHOOK_EVENTS_INSTANCE_CREATE=true
WEBHOOK_EVENTS_INSTANCE_DELETE=true
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_MESSAGES_SET=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_MESSAGES_EDITED=true
WEBHOOK_EVENTS_MESSAGES_UPDATE=true
WEBHOOK_EVENTS_MESSAGES_DELETE=true
WEBHOOK_EVENTS_SEND_MESSAGE=true
WEBHOOK_EVENTS_SEND_MESSAGE_UPDATE=true
WEBHOOK_EVENTS_CONTACTS_SET=true
WEBHOOK_EVENTS_CONTACTS_UPSERT=true
WEBHOOK_EVENTS_CONTACTS_UPDATE=true
WEBHOOK_EVENTS_PRESENCE_UPDATE=true
WEBHOOK_EVENTS_CHATS_SET=true
WEBHOOK_EVENTS_CHATS_UPSERT=true
WEBHOOK_EVENTS_CHATS_UPDATE=true
WEBHOOK_EVENTS_CHATS_DELETE=true
WEBHOOK_EVENTS_GROUPS_UPSERT=true
WEBHOOK_EVENTS_GROUPS_UPDATE=true
WEBHOOK_EVENTS_GROUP_PARTICIPANTS_UPDATE=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_LABELS_EDIT=true
WEBHOOK_EVENTS_LABELS_ASSOCIATION=true
WEBHOOK_EVENTS_CALL=true
WEBHOOK_REQUEST_TIMEOUT_MS=60000
WEBHOOK_RETRY_MAX_ATTEMPTS=10
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true
WEBHOOK_RETRY_MAX_DELAY_SECONDS=300
WEBHOOK_RETRY_JITTER_FACTOR=0.2

PROMETHEUS_METRICS=true
METRICS_AUTH_REQUIRED=true
METRICS_USER=prometheus
METRICS_PASSWORD=CHANGE_ME_METRICS_PASSWORD
METRICS_ALLOWED_IPS=

ARGWS_CONNECT_TELEMETRY_ENABLED=false
ARGWS_CONNECT_TELEMETRY_MODE=agent
ARGWS_CONNECT_TELEMETRY_URL=http://127.0.0.1:47831/v1/telemetry
ARGWS_CONNECT_TELEMETRY_AGENT_TOKEN=
ARGWS_CONNECT_TELEMETRY_ACTIVATION_TOKEN=
ARGWS_CONNECT_TELEMETRY_SCHEMA=argws.connect.api.route
ARGWS_CONNECT_TELEMETRY_SCHEMA_VERSION=1
ARGWS_CONNECT_TELEMETRY_TIMEOUT_MS=3000

# --------------------------------------------------------------------------
# Platform / Control Plane
# --------------------------------------------------------------------------
PLATFORM_APP_ENV=development
PLATFORM_APP_SECRET_KEY=CHANGE_ME_PLATFORM_APP_SECRET_KEY
PLATFORM_FIELD_ENCRYPTION_KEY=CHANGE_ME_PLATFORM_FIELD_ENCRYPTION_KEY
PLATFORM_INTERNAL_SERVICES_PASSWORD=CHANGE_ME_PLATFORM_INTERNAL_PASSWORD
DOMAIN_RECONCILIATION_TOKEN=CHANGE_ME_DOMAIN_TOKEN
PLATFORM_POSTGRES_DB=connect_api_platform_develop
PLATFORM_POSTGRES_USER=connect_api_platform
PLATFORM_POSTGRES_PASSWORD=CHANGE_ME_PLATFORM_POSTGRES_PASSWORD
TENANT_DB_PREFIX=connect_api_tenant_develop
TENANT_DB_USER_PREFIX=connect_api_t_dev
S3_BUCKET_PREFIX=connect-api-develop-tenant
PLATFORM_ADMIN_NAME=Administrador da Plataforma
PLATFORM_ADMIN_EMAIL=admin@connect.argws.com.br
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_PLATFORM_ADMIN_PASSWORD
BOOTSTRAP_DEMO_TENANT=true
DEMO_TENANT_NAME=Empresa Demonstração
DEMO_TENANT_SLUG=demo
DEMO_TENANT_ADMIN_NAME=Administrador Demo
DEMO_TENANT_ADMIN_EMAIL=admin.demo@connect.argws.com.br
DEMO_TENANT_ADMIN_PASSWORD=CHANGE_ME_DEMO_ADMIN_PASSWORD
PLATFORM_API_WORKERS=2
PLATFORM_CELERY_CONCURRENCY=2
CONNECT_ENGINE_TIMEOUT_SECONDS=30

# --------------------------------------------------------------------------
# E-mail interno da Connect|API Platform — DEVELOP
# --------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_FROM_EMAIL=nao-responda@connect.argws.com.br
SMTP_FROM_NAME=Connect|API Platform
SMTP_TIMEOUT_SECONDS=30
PASSWORD_RESET_URL=https://d.control.connect.argws.com.br/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_REQUESTS_PER_ACCOUNT_HOUR=5
PASSWORD_RESET_REQUESTS_PER_IP_HOUR=30
PASSWORD_RESET_ATTEMPTS_PER_IP_HOUR=30

# --------------------------------------------------------------------------
# Integrações opcionais — desligadas por padrão no develop da Platform
# --------------------------------------------------------------------------
TYPEBOT_ENABLED=false
TYPEBOT_API_VERSION=latest
TYPEBOT_SEND_MEDIA_BASE64=false
CHATWOOT_ENABLED=false
CHATWOOT_MESSAGE_READ=true
CHATWOOT_MESSAGE_DELETE=true
CHATWOOT_BOT_CONTACT=true
CHATWOOT_IMPORT_DATABASE_CONNECTION_URI=
CHATWOOT_IMPORT_PLACEHOLDER_MEDIA_MESSAGE=true
OPENAI_ENABLED=false
OPENAI_API_KEY_GLOBAL=
DIFY_ENABLED=false
N8N_ENABLED=false
CONNECT_AI_ENABLED=false
FLOWISE_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_CONFIG_ID=
FACEBOOK_USER_TOKEN=
PROVIDER_ENABLED=false
PROVIDER_HOST=
PROVIDER_PORT=5656
PROVIDER_PREFIX=argws-connect-platform-develop
