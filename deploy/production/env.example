# ============================================================
# ARGWS Connect API - PRODUCAO / STACK LOCAL COMPLETA
# Arquivo canônico de exemplo. Copie para .env antes do deploy.
# Uma unica porta publicada: API. Manager em /manager.
# Infraestrutura (PostgreSQL, Redis, RabbitMQ, MinIO, etc.)
# permanece somente na rede Docker interna.
# Política de imagem: produção usa tag versionada promovida; homologação testa :latest.
# ============================================================

COMPOSE_PROJECT_NAME=argws-connect-production
TZ=America/Bahia
ARGWS_CONNECT_NETWORK_NAME=argws-connect-production-net
ARGWS_CONNECT_BIND_ADDRESS=127.0.0.1
ARGWS_CONNECT_API_HOST_PORT=38080
COMPOSE_PROFILES=
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5

ARGWS_CONNECT_API_IMAGE=ghcr.io/wkarts/argws-connect-api:1.0.4
ARGWS_CONNECT_POSTGRES_IMAGE=ghcr.io/wkarts/argws-connect-postgres:15
ARGWS_CONNECT_REDIS_IMAGE=ghcr.io/wkarts/argws-connect-redis:latest
ARGWS_CONNECT_RABBITMQ_IMAGE=ghcr.io/wkarts/argws-connect-rabbitmq:management
ARGWS_CONNECT_MINIO_IMAGE=ghcr.io/wkarts/argws-connect-minio:latest
ARGWS_CONNECT_MYSQL_IMAGE=ghcr.io/wkarts/argws-connect-mysql:8.0
ARGWS_CONNECT_NATS_IMAGE=ghcr.io/wkarts/argws-connect-nats:2.10-alpine
ARGWS_CONNECT_KAFKA_IMAGE=ghcr.io/wkarts/argws-connect-kafka:7.5.0
ARGWS_CONNECT_ZOOKEEPER_IMAGE=ghcr.io/wkarts/argws-connect-zookeeper:7.5.0

ARGWS_CONNECT_INSTANCES_DATA_PATH=./volumes/instances
ARGWS_CONNECT_POSTGRES_DATA_PATH=./volumes/postgres
ARGWS_CONNECT_REDIS_DATA_PATH=./volumes/redis
ARGWS_CONNECT_RABBITMQ_DATA_PATH=./volumes/rabbitmq
ARGWS_CONNECT_MINIO_DATA_PATH=./volumes/minio
ARGWS_CONNECT_MYSQL_DATA_PATH=./volumes/mysql
ARGWS_CONNECT_NATS_DATA_PATH=./volumes/nats
ARGWS_CONNECT_KAFKA_DATA_PATH=./volumes/kafka
ARGWS_CONNECT_ZOOKEEPER_DATA_PATH=./volumes/zookeeper/data
ARGWS_CONNECT_ZOOKEEPER_LOG_PATH=./volumes/zookeeper/log
ARGWS_CONNECT_LOGS_DATA_PATH=./volumes/logs
ARGWS_CONNECT_BACKUPS_DATA_PATH=./volumes/backups

SERVER_NAME=argws-connect-api
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://api.connect.argws.com.br
SSL_CONF_PRIVKEY=
SSL_CONF_FULLCHAIN=
SERVER_DISABLE_DOCS=false
SERVER_DISABLE_MANAGER=false
NODE_ENV=PROD
DOCKER_ENV=true
LANGUAGE=pt-BR

ARGWS_CONNECT_TELEMETRY_ENABLED=false
ARGWS_CONNECT_TELEMETRY_MODE=agent
ARGWS_CONNECT_TELEMETRY_URL=http://127.0.0.1:47831/v1/telemetry
ARGWS_CONNECT_TELEMETRY_AGENT_TOKEN=
ARGWS_CONNECT_TELEMETRY_ACTIVATION_TOKEN=
ARGWS_CONNECT_TELEMETRY_SCHEMA=argws.connect.api.route
ARGWS_CONNECT_TELEMETRY_SCHEMA_VERSION=1
ARGWS_CONNECT_TELEMETRY_TIMEOUT_MS=3000

PROMETHEUS_METRICS=true
METRICS_AUTH_REQUIRED=true
METRICS_USER=prometheus
METRICS_PASSWORD=CHANGE_ME_METRICS_PASSWORD
METRICS_ALLOWED_IPS=

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=false

LOG_LEVEL=ERROR,WARN,INFO,LOG,WEBHOOKS,WEBSOCKET
LOG_COLOR=true
LOG_BAILEYS=error
LOG_QRCODE=true
EVENT_EMITTER_MAX_LISTENERS=100
DEL_INSTANCE=false
DEL_TEMP_INSTANCES=false

PROXY_HOST=
PROXY_PORT=
PROXY_PROTOCOL=
PROXY_USERNAME=
PROXY_PASSWORD=
API_AUDIO_CONVERTER=
API_AUDIO_CONVERTER_KEY=

DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://argws_connect:CHANGE_ME_POSTGRES_PASSWORD@argws-connect-postgres:5432/argws_connect_api?schema=public
DATABASE_CONNECTION_CLIENT_NAME=argws-connect-production
POSTGRES_DATABASE=argws_connect_api
POSTGRES_USERNAME=argws_connect
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_MAX_CONNECTIONS=300
DATABASE_MIGRATION_MAX_ATTEMPTS=60
DATABASE_MIGRATION_RETRY_SECONDS=2
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true
DATABASE_BOUNCER_CONNECTION_URI=

MYSQL_DATABASE=argws_connect_api
MYSQL_USERNAME=argws_connect
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:CHANGE_ME_REDIS_PASSWORD@argws-connect-redis:6379/0
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=argws-connect-production
CACHE_REDIS_SAVE_INSTANCES=false
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
CACHE_LOCAL_ENABLED=false
CACHE_LOCAL_TTL=86400

RABBITMQ_ENABLED=true
RABBITMQ_URI=amqp://argws_connect:CHANGE_ME_RABBITMQ_PASSWORD@argws-connect-rabbitmq:5672/argws_connect
RABBITMQ_EXCHANGE_NAME=argws_connect
RABBITMQ_FRAME_MAX=131072
RABBITMQ_GLOBAL_ENABLED=true
RABBITMQ_PREFIX_KEY=argws-connect-production
RABBITMQ_DEFAULT_VHOST=argws_connect
RABBITMQ_DEFAULT_USER=argws_connect
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_EVENTS_APPLICATION_STARTUP=true
RABBITMQ_EVENTS_INSTANCE_CREATE=true
