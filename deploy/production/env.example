RABBITMQ_EVENTS_TYPEBOT_START=false
RABBITMQ_EVENTS_TYPEBOT_CHANGE_STATUS=false

WEBSOCKET_ENABLED=true
WEBSOCKET_GLOBAL_EVENTS=true
WEBSOCKET_ALLOWED_HOSTS=127.0.0.1,::1,api.connect.argws.com.br

S3_ENABLED=true
S3_ACCESS_KEY=argws_connect
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=argws-connect-production
S3_PORT=9000
S3_ENDPOINT=argws-connect-minio
