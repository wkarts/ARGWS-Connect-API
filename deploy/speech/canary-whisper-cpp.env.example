# Experimental configuration for the existing pool. Apply only in develop.
# Merge these values into the selected installation environment after provisioning
# the pinned model. Keep that installation's secrets, profiles, volumes and images.
# Do not start another worker. The 1280m cgroup includes coordinator, native engine
# and tmpfs. This budget is a test target; it is not a measured VPS capacity.
SPEECH_ENGINE=whisper.cpp
SPEECH_PROVIDER=local
# Keep an existing custom private bucket; otherwise empty derives S3_BUCKET + "-speech".
SPEECH_S3_BUCKET_NAME=
SPEECH_WORKER_MODE=pool
# Optional shared host cgroup; configure its budget before assigning pools.
SPEECH_CGROUP_PARENT=
SPEECH_ENABLED=true
TRANSCRIPTION_ENABLED=true
DICTATION_ENABLED=true
MANAGER_FEATURE_TRANSCRIPTION=true
SPEECH_MODEL=whisper-base-q5_1
SPEECH_MODEL_PATH=/models/whisper.cpp/base-q5_1
SPEECH_MODEL_CACHE_DIR=/models
SPEECH_WHISPER_CPP_BINARY=/usr/local/bin/whisper-server
SPEECH_WHISPER_CPP_PORT=8178
SPEECH_WHISPER_MODEL_FILE=/models/whisper.cpp/base-q5_1/ggml-base-q5_1.bin
SPEECH_WHISPER_MODEL_SHA256=422f1ae452ade6f30a004d7e5c6a43195e4433bc370bf23fac9cc591f01a8898
SPEECH_MODEL_IDLE_TTL_SECONDS=300
SPEECH_TRANSCRIPTION_REPLICAS=1
SPEECH_GLOBAL_CONCURRENCY=1
SPEECH_WORKER_CONCURRENCY=1
SPEECH_INFERENCE_THREADS=1
SPEECH_INFERENCE_INTER_THREADS=1
SPEECH_WORKER_MEMORY=1280m
SPEECH_WORKER_CPUS=1.00
TRANSCRIPTION_WORKER_TMPFS_SIZE=128m
SPEECH_MAX_PENDING_JOBS=50
SPEECH_MAX_PENDING_AUDIO_BYTES_PER_INSTANCE=131072000
SPEECH_MAX_PENDING_AUDIO_BYTES=1310720000
SPEECH_MAX_PENDING_AUDIO_SECONDS_PER_INSTANCE=18000
SPEECH_MAX_PENDING_AUDIO_SECONDS=180000
SPEECH_MAX_PENDING_JOBS_PER_INSTANCE=5
SPEECH_MAX_UPLOADS=2
SPEECH_MAX_UPLOADS_PER_INSTANCE=1
SPEECH_MAX_UPLOAD_BYTES=52428800
TRANSCRIPTION_MAX_AUDIO_BYTES=26214400
SPEECH_CHUNK_SECONDS=30
SPEECH_CHUNK_DEADLINE_SECONDS=180
DICTATION_MAX_DURATION_SECONDS=60
DICTATION_JOB_DEADLINE_SECONDS=120
