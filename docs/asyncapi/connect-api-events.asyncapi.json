    "findhub.auth.update": {
      "description": "Nome reservado no catálogo atual. O Auth Broker não emite esse evento nos métodos start/import/status; acompanhe a autenticação pelo endpoint de status.",
      "subscribe": {
        "operationId": "consume_findhub_auth_update",
        "message": {
          "$ref": "#/components/messages/findhub_auth_update"
        }
      }
    },
