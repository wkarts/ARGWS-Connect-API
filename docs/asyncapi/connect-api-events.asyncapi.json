{
  "asyncapi": "2.6.0",
  "info": {
    "title": "Connect|API — Eventos",
    "version": "1.1.3",
    "description": "![Connect|API Events](openapi/branding/docs/connect-api-events-light.png)\n\nEventos do Connect|API publicáveis por Webhook, WebSocket, RabbitMQ, NATS, SQS, Pusher ou Kafka conforme configuração e suporte."
  },
  "channels": {
    "application.startup": {
      "description": "Evento `application.startup` do Connect|API. A disponibilidade externa depende do transporte habilitado na instância.",
