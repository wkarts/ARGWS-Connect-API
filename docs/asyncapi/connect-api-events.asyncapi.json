  "components": {
    "messages": {
      "findhub_auth_update": {
        "name": "findhub_auth_update",
        "title": "findhub.auth.update",
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "event": {
              "type": "string"
            },
            "instance": {},
            "data": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "findhub_devices_updated": {
        "name": "findhub_devices_updated",
        "title": "findhub.devices.updated",
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "event": {
              "type": "string"
            },
            "instance": {},
            "data": {
              "type": "object",
              "properties": {
                "devices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "identifierType": {
                        "type": "string"
                      },
                      "deviceType": {
                        "type": "string"
                      },
                      "trackingEnabled": {
                        "type": "boolean"
                      },
                      "lastLocationAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "catalog": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "complete": {
                      "type": "boolean",
                      "description": "Todas as fontes solicitadas responderam e seus registros foram decodificados. Não garante visibilidade de todo item apresentado por outros produtos Google."
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "integer",
                            "enum": [
                              1,
                              2,
                              5,
                              7
                            ]
                          },
                          "status": {
                            "enum": [
                              "OK",
                              "UNAVAILABLE"
                            ]
                          },
                          "returned": {
                            "type": "integer"
                          },
                          "decoded": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "findhub_location_updated": {
        "name": "findhub_location_updated",
        "title": "findhub.location.updated",
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "event": {
              "type": "string"
            },
            "instance": {},
            "data": {
              "type": "object",
              "properties": {
                "device": {
                  "type": "object",
                  "additionalProperties": true
                },
                "location": {
                  "type": "object",
                  "required": [
                    "deviceId",
                    "googleDeviceId",
                    "latitude",
                    "longitude",
                    "timestamp",
                    "source",
                    "ownReport"
                  ],
                  "properties": {
                    "deviceId": {
                      "type": "string"
                    },
                    "googleDeviceId": {
                      "type": "string"
                    },
                    "latitude": {
                      "type": "number"
                    },
                    "longitude": {
                      "type": "number"
                    },
                    "altitude": {
                      "type": "number"
                    },
                    "accuracy": {
                      "type": "number"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "RECENT",
                        "NETWORK",
                        "LAST_KNOWN",
                        "CROWDSOURCED",
                        "AGGREGATED",
                        "UNKNOWN"
                      ]
                    },
                    "semanticLocation": {
                      "type": "string"
                    },
                    "ownReport": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "findhub_tracking_update": {
        "name": "findhub_tracking_update",
        "title": "findhub.tracking.update",
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "event": {
              "type": "string"
            },
            "instance": {},
            "data": {
              "type": "object",
              "required": [
                "deviceId",
                "enabled"
              ],
              "properties": {
                "deviceId": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "intervalSeconds": {
                  "type": "integer"
                },
                "lastAttemptAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "nextAttemptAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "failures": {
                  "type": "integer"
                },
                "lastError": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "findhub_error": {
        "name": "findhub_error",
        "title": "findhub.error",
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "event": {
              "type": "string"
            },
            "instance": {},
            "data": {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string"
                },
                "deviceId": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        }
      },
      "ConnectEvent": {
        "name": "ConnectEvent",
        "title": "Evento Connect|API",
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "event": {
              "type": "string"
            },
            "instance": {},
            "data": {}
          }
        }
      }
    }
  }
}
