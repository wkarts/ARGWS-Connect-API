            "format": "email"
          },
          "type": {
            "type": "string",
            "description": "Tipo do e-mail."
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": true
      },
      "MetaContactUrl": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "URL do contato.",
            "format": "uri"
          },
          "type": {
            "type": "string",
            "description": "Tipo da URL."
          }
        },
        "required": [
          "url"
