            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "name": {
            "type": "string",
            "description": "Nome opcional do local."
          },
          "address": {
            "type": "string",
            "description": "Endereço opcional do local."
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "additionalProperties": false
      },
      "MetaContactName": {
        "type": "object",
        "properties": {
          "formatted_name": {
            "type": "string",
