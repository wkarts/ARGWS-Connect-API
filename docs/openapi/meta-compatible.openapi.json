          }
        },
        "additionalProperties": true
      },
      "MetaContact": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/MetaContactName"
          },
          "phones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/MetaContactPhone"
            }
          },
          "emails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetaContactEmail"
            }
          },
          "urls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetaContactUrl"
            }
          },
          "org": {
            "$ref": "#/components/schemas/MetaContactOrg"
          }
        },
        "required": [
