          },
          "filename": {
            "type": "string",
            "description": "Nome do arquivo enviado ao destinatário."
          },
          "caption": {
            "type": "string",
            "description": "Legenda opcional."
          },
          "mime_type": {
            "type": "string",
            "description": "MIME type opcional."
          }
        },
        "anyOf": [
          {
            "required": [
              "link"
            ]
          },
          {
            "required": [
              "id"
            ]
          }
        ],
        "additionalProperties": false
      },
      "MetaAudioContent": {
        "type": "object",
        "description": "Áudio referenciado por link público ou id previamente enviado ao endpoint de mídia.",
        "properties": {
          "link": {
            "type": "string",
