          "reply"
        ],
        "additionalProperties": false
      },
      "MetaInteractiveListRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador da linha."
          },
          "title": {
            "type": "string",
            "description": "Título da opção."
          },
          "description": {
            "type": "string",
            "description": "Descrição opcional da opção."
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
